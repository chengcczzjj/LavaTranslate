<?xml version="1.0" encoding="utf-8"?>
<!-- 仅调试版：自测用的演示页面（显示一个外语聊天网页，供悬浮球翻译） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".DemoActivity"
            android:exported="true"
            android:label="Lava Demo"
            android:taskAffinity="com.lavatranslate.app.demo" />
        <!-- 模拟别的应用的小悬浮窗（录屏控制条），见 FloatTestActivity -->
        <activity
            android:name=".FloatTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="com.lavatranslate.app.floattest"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
